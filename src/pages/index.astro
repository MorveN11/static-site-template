---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your Name - Developer" description="Personal site of Your Name.">
  <section class="mb-12">
    <h1 class="text-4xl font-bold">Hi, I'm Your Name.</h1>
    <p class="mt-4 text-lg text-muted">
      I build things for the web. This is a short line about what you do and what you care about.
    </p>
    <p class="mt-6 flex gap-4">
      <a href="/projects">See my projects</a>
      <a href="/about">About me</a>
    </p>
  </section>
</BaseLayout>
