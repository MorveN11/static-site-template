---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Your Name - Developer" description="Portfolio and blog of Your Name.">
  <section class="mb-12">
    <h1 class="text-4xl font-bold">Hi, I'm Your Name.</h1>
    <p class="mt-4 text-lg text-muted">
      I build things for the web. This is a short line about what you do and what you care about.
    </p>
    <p class="mt-6 flex gap-4">
      <a href="/projects">See my projects</a>
      <a href="/about">About me</a>
    </p>
  </section>

  <section aria-labelledby="latest">
    <h2 id="latest" class="mb-4 text-2xl font-bold">Latest posts</h2>
    <ul class="space-y-4">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="font-semibold">
              {post.data.title}
            </a>
            <time datetime={post.data.date.toISOString()} class="block text-sm text-muted">
              {post.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
            </time>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-4"><a href="/blog">All posts</a></p>
  </section>
</BaseLayout>
