---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog - Your Name" description="Posts by Your Name.">
  <h1 class="mb-6 text-3xl font-bold">Blog</h1>
  <ul class="space-y-6">
    {
      posts.map((post) => (
        <li>
          <h2 class="text-xl font-semibold">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h2>
          <time datetime={post.data.date.toISOString()} class="block text-sm text-muted">
            {post.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
          </time>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
