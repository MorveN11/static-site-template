---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Your Name" description="About Your Name.">
  <h1 class="mb-6 text-3xl font-bold">About</h1>
  <div class="prose">
    <p>Write a few sentences about yourself, your background and what you are working on.</p>
    <p>Add what you are interested in, how to reach you, and anything else visitors should know.</p>
  </div>
</BaseLayout>
