{
  "name": "static-site-template",
  "description": "Minimal Astro starter for static sites: static output, nginx Docker image, Dokploy CI/CD.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morvenlabs/static-site-template.git"
  },
  "homepage": "https://github.com/morvenlabs/static-site-template#readme",
  "bugs": {
    "url": "https://github.com/morvenlabs/static-site-template/issues"
  },
  "keywords": [
    "astro",
    "portfolio",
    "static-site",
    "template",
    "nginx",
    "docker",
    "dokploy"
  ],
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "compose": "docker compose --env-file .env up -d --build",
    "down": "docker compose --env-file .env down"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.6",
    "typescript": "6.0.3"
  }
}
